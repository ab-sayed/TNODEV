{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 240
  /ImageMatrix [330 0 0 240 0 0]
  /Width 330
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
