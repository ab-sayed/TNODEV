function plot_reachable_sets()
    %% Initialization
    close all;
    % Define specific colors: red, green, blue, magenta, cyan, yellow, purple
    colors = [1, 0, 0;    % Red
              0, 1, 0;    % Green
              0, 0, 1;    % Blue
              1, 0, 1;    % Magenta
              0, 1, 1;    % Cyan
              1, 1, 0;    % Yellow
              0.5, 0, 0.5]; % Purple
    % Assign colors to combinations
    color_map = containers.Map({'single-step Mixed-Monotonicity', 'incremental Mixed-Monotonicity', ...
                               'single-step Sampled-Data Mixed-Monotonicity', 'incremental Sampled-Data Mixed-Monotonicity', ...
                               'NNV2.0 Star Set', 'incremental NNV Star Set', 'CORA Zonotope'}, ...
                              mat2cell(colors, ones(1, 7)));

    method_names = {'Mixed-Monotonicity', 'Sampled-Data Mixed-Monotonicity', 'NNV Star Set', 'CORA Zonotope'};

    %% Load data from multiple runs
    files = dir('reachability_data_sys*.mat');
    if isempty(files)
        error('No reachability data files found. Run the main script first.');
    end

    all_succ_low = {};
    all_succ_up = {};
    all_rand_succ = {};
    all_t_points = {};
    all_methods = {};
    all_n_x = [];
    all_n_methods = [];
    all_final_sets = {};

    for i = 1:length(files)
        data = load(files(i).name);
        % Check file type
        is_tira = isfield(data, 'succ_low_all_methods') && isfield(data, 'succ_up_all_methods') && isfield(data, 'methods');
        is_nnv = contains(files(i).name, 'NNV');
        is_cora = contains(files(i).name, 'CORA') || isfield(data, 'final_reachable_set');
        
        if is_tira
            all_succ_low{end+1} = data.succ_low_all_methods;
            all_succ_up{end+1} = data.succ_up_all_methods;
            all_t_points{end+1} = data.t_points;
            all_methods{end+1} = data.methods;
            all_n_methods(end+1) = data.n_methods;
            all_n_x(end+1) = data.n_x;
            all_final_sets{end+1} = [];
        elseif is_nnv
            if isfield(data, 'succ_low_all_methods') && isfield(data, 'succ_up_all_methods')
                all_succ_low{end+1} = data.succ_low_all_methods;
                all_succ_up{end+1} = data.succ_up_all_methods;
            else
                all_succ_low{end+1} = nan(data.n_x, 1, 1);
                all_succ_up{end+1} = nan(data.n_x, 1, 1);
            end
            all_t_points{end+1} = data.t_points;
            all_methods{end+1} = [5]; % Method index 5 for NNV
            all_n_methods(end+1) = 1;
            all_n_x(end+1) = data.n_x;
            all_final_sets{end+1} = [];
        elseif is_cora
            if isfield(data, 'succ_low_all_methods') && isfield(data, 'succ_up_all_methods')
                all_succ_low{end+1} = data.succ_low_all_methods;
                all_succ_up{end+1} = data.succ_up_all_methods;
            elseif isfield(data, 'final_reachable_set')
                final_interval = interval(data.final_reachable_set);
                succ_low = final_interval.inf;
                succ_up = final_interval.sup;
                all_succ_low{end+1} = reshape(succ_low, [size(succ_low, 1), 1, 1]);
                all_succ_up{end+1} = reshape(succ_up, [size(succ_up, 1), 1, 1]);
            else
                all_succ_low{end+1} = nan(data.n_x, 1, 1);
                all_succ_up{end+1} = nan(data.n_x, 1, 1);
            end
            if isfield(data, 't_points')
                all_t_points{end+1} = data.t_points;
            else
                all_t_points{end+1} = [data.tFinal];
            end
            if isfield(data, 'methods')
                all_methods{end+1} = data.methods;
            else
                all_methods{end+1} = [6];
            end
            if isfield(data, 'n_methods')
                all_n_methods(end+1) = data.n_methods;
            else
                all_n_methods(end+1) = 1;
            end
            if isfield(data, 'n_x')
                all_n_x(end+1) = data.n_x;
            elseif isfield(data, 'dim')
                all_n_x(end+1) = data.dim;
            else
                all_n_x(end+1) = 5;
            end
            if isfield(data, 'final_reachable_set')
                all_final_sets{end+1} = data.final_reachable_set;
                fprintf('Loaded final_reachable_set for file %s: %s\n', files(i).name, class(all_final_sets{end}));
            else
                all_final_sets{end+1} = [];
                fprintf('No final_reachable_set found for file %s\n', files(i).name);
            end
        else
            warning('Unrecognized file type for %s. Skipping.', files(i).name);
            continue;
        end
        if isfield(data, 'rand_succ')
            all_rand_succ{end+1} = data.rand_succ;
        elseif isfield(data, 'final_states')
            all_rand_succ{end+1} = data.final_states;
        elseif isfield(data, 'final_states_sampled')
            all_rand_succ{end+1} = data.final_states_sampled;
        else
            all_rand_succ{end+1} = zeros(all_n_x(end), 0);
        end
    end

    % Verify consistency
    if length(unique(all_n_x)) > 1 || length(unique(all_n_methods)) > 1
        warning('Inconsistent state or method dimensions across files. Using first file''s dimensions.');
    end
    n_x = all_n_x(1);
    n_methods = max(all_n_methods);

    %% Plotting
    if n_x == 5
        plot_pairs = [1 2; 3 4; 4 5];
        for i = 1:size(plot_pairs, 1)
            figure;
            hold on;
            grid on;
            idx1 = plot_pairs(i, 1);
            idx2 = plot_pairs(i, 2);

            % Plot random successors from all runs
            for j = 1:length(all_rand_succ)
                scatter(all_rand_succ{j}(idx1, :), all_rand_succ{j}(idx2, :), 5, 'k', 'filled');
            end

            % Plot last reachable sets for each file
            handles = [];
            proxy_handles = [];
            legends = {};
            for j = 1:length(files)
                approach_tokens = regexp(files(j).name, '_(initial|incremental)_', 'tokens');
                if isempty(approach_tokens) && contains(files(j).name, 'CORA')
                    approach = 'CORA';
                else
                    approach = approach_tokens{1}{1};
                end
                file_methods = all_methods{j};
                is_nnv = contains(files(j).name, 'NNV');
                is_cora = strcmp(approach, 'CORA');

                if is_nnv
                    for app = {'initial', 'incremental'}
                        app_str = app{1};
                        if strcmp(app_str, approach) || all(isnan(all_succ_low{j}(idx1, :, :)))
                            for m = 3:3
                                method_idx = find(file_methods == m + 2);
                                if ~isempty(method_idx)
                                    k = find(~all(isnan([all_succ_low{j}(idx1, :, method_idx), all_succ_up{j}(idx1, :, method_idx)]), 1), 1, 'last');
                                    if isempty(k)
                                        fprintf('No valid data for file %s, approach %s, method %s\n', files(j).name, app_str, method_names{m});
                                        continue;
                                    end
                                    x_min = all_succ_low{j}(idx1, k, method_idx);
                                    y_min = all_succ_low{j}(idx2, k, method_idx);
                                    width = all_succ_up{j}(idx1, k, method_idx) - x_min;
                                    height = all_succ_up{j}(idx2, k, method_idx) - y_min;
                                    if any(isnan([x_min, y_min, width, height])) || width <= 0 || height <= 0
                                        fprintf('Invalid data for file %s, approach %s, method %s at t=%d: x_min=%.2f, y_min=%.2f, width=%.2f, height=%.2f\n', ...
                                                files(j).name, app_str, method_names{m}, k, x_min, y_min, width, height);
                                        continue;
                                    end
                                    key = strcmp(app_str, 'initial') ? 'NNV2.0 Star Set' : sprintf('%s %s', app_str, 'NNV Star Set');
                                    legend_str = sprintf('%s (%s)', method_names{m}, app_str);
                                    color = color_map(key);
                                    line_width = 2;
                                    h = rectangle('Position', [x_min, y_min, width, height], 'EdgeColor', color, 'LineWidth', line_width, 'LineStyle', '-');
                                    handles = [handles, h];
                                    h_proxy = plot(nan, nan, 'Color', color, 'LineWidth', line_width, 'LineStyle', '-', 'Visible', 'off');
                                    proxy_handles = [proxy_handles, h_proxy];
                                    legends{end+1} = legend_str;
                                end
                            end
                        end
                    end
                elseif is_cora
                    for m = 4:4
                        method_idx = find(file_methods == m + 2);
                        if ~isempty(method_idx)
                            k = find(~all(isnan([all_succ_low{j}(idx1, :, method_idx), all_succ_up{j}(idx1, :, method_idx)]), 1), 1, 'last');
                            if isempty(k)
                                fprintf('No valid data for file %s, approach %s, method %s\n', files(j).name, approach, method_names{m});
                                continue;
                            end
                            x_min = all_succ_low{j}(idx1, k, method_idx);
                            y_min = all_succ_low{j}(idx2, k, method_idx);
                            width = all_succ_up{j}(idx1, k, method_idx) - x_min;
                            height = all_succ_up{j}(idx2, k, method_idx) - y_min;
                            if any(isnan([x_min, y_min, width, height])) || width <= 0 || height <= 0
                                fprintf('Invalid data for file %s, approach %s, method %s at t=%d: x_min=%.2f, y_min=%.2f, width=%.2f, height=%.2f\n', ...
                                        files(j).name, approach, method_names{m}, k, x_min, y_min, width, height);
                                continue;
                            end
                            key = 'CORA Zonotope';
                            color = color_map(key);
                            line_width = 2;
                            if ~isempty(all_final_sets{j}) && isa(all_final_sets{j}, 'zonotope')
                                try
                                    h = plot(all_final_sets{j}, [idx1, idx2], 'EdgeColor', color, 'LineWidth', line_width);
                                    fprintf('Successfully plotted zonotope for file %s\n', files(j).name);
                                catch e
                                    fprintf('Failed to plot zonotope for file %s: %s\n', files(j).name, e.message);
                                    h = rectangle('Position', [x_min, y_min, width, height], 'EdgeColor', color, 'LineWidth', line_width, 'LineStyle', '-');
                                end
                            else
                                fprintf('No valid zonotope or empty set for file %s, falling back to rectangle\n', files(j).name);
                                h = rectangle('Position', [x_min, y_min, width, height], 'EdgeColor', color, 'LineWidth', line_width, 'LineStyle', '-');
                            end
                            handles = [handles, h];
                            h_proxy = plot(nan, nan, 'Color', color, 'LineWidth', line_width, 'LineStyle', '-', 'Visible', 'off');
                            proxy_handles = [proxy_handles, h_proxy];
                            legends{end+1} = method_names{m};
                        end
                    end
                else
                    for m = 1:2
                        method_value = find(file_methods == m + 2);
                        if ~isempty(method_value)
                            method_idx = method_value(1);
                            k = find(~all(isnan([all_succ_low{j}(idx1, :, method_idx), all_succ_up{j}(idx1, :, method_idx)]), 1), 1, 'last');
                            if isempty(k)
                                fprintf('No valid data for file %s, approach %s, method %s\n', files(j).name, approach, method_names{m});
                                continue;
                            end
                            x_min = all_succ_low{j}(idx1, k, method_idx);
                            y_min = all_succ_low{j}(idx2, k, method_idx);
                            width = all_succ_up{j}(idx1, k, method_idx) - x_min;
                            height = all_succ_up{j}(idx2, k, method_idx) - y_min;
                            if any(isnan([x_min, y_min, width, height])) || width <= 0 || height <= 0
                                fprintf('Invalid data for file %s, approach %s, method %s at t=%d: x_min=%.2f, y_min=%.2f, width=%.2f, height=%.2f\n', ...
                                        files(j).name, approach, method_names{m}, k, x_min, y_min, width, height);
                                continue;
                            end
                            if strcmp(approach, 'initial')
                                key = m == 1 ? 'single-step Mixed-Monotonicity' : 'single-step Sampled-Data Mixed-Monotonicity';
                                legend_str = sprintf('%s (single-step)', method_names{m});
                            else
                                key = sprintf('%s %s', approach, method_names{m});
                                legend_str = sprintf('%s (%s)', method_names{m}, approach);
                            end
                            color = color_map(key);
                            line_width = strcmp(key, 'incremental Mixed-Monotonicity') ? 8 : 2;
                            h = rectangle('Position', [x_min, y_min, width, height], 'EdgeColor', color, 'LineWidth', line_width, 'LineStyle', '-');
                            handles = [handles, h];
                            h_proxy = plot(nan, nan, 'Color', color, 'LineWidth', line_width, 'LineStyle', '-', 'Visible', 'off');
                            proxy_handles = [proxy_handles, h_proxy];
                            legends{end+1} = legend_str;
                        end
                    end
                end
            end

            if ~isempty(proxy_handles) && length(proxy_handles) == length(legends)
                xlabel(['$x_', num2str(idx1), '$'], 'Interpreter', 'Latex', 'FontSize', 20);
                ylabel(['$x_', num2str(idx2), '$'], 'Interpreter', 'Latex', 'FontSize', 20);
                title(['$x_', num2str(idx1), '$ vs. $x_', num2str(idx2), '$'], 'Interpreter', 'Latex', 'FontSize', 16);
                legend(proxy_handles, legends, 'Location', 'southeast');
            else
                warning('No valid rectangles or mismatched handles/legends for this plot. Skipping legend.');
            end
            hold off;
        end
    else
        warning('Plotting is set up only for systems with 5 states.');
    end
end