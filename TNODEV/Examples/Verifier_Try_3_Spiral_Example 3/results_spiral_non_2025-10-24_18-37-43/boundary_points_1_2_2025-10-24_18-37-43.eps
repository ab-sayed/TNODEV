/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 244
  /ImageMatrix [560 0 0 244 0 0]
  /Width 560
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
