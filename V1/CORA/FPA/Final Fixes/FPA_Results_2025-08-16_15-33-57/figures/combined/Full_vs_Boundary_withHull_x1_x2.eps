/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 420
  /ImageMatrix [324 0 0 420 0 0]
  /Width 324
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
