% 
%         % --- A. Define Input Interval (Box) ---
%         img = XTest(:,:,:,i);
%         x_c = img; 
%         x_r = zeros(size(img));
% 
%         % Apply Noise
%         pixels_attack = randperm(784, pix);
%         for p = pixels_attack
