%     w2 = [-0.58693904, -0.814841  , -0.8175157 ,  0.97060364,  0.6908913 ,...
%          -0.92446184, -0.79249185, -1.1507587 ,  1.2072723 , -0.7983982 ;
%           1.1564877 , -0.8991244 , -1.0774536 , -0.6731967 ,  1.0154784 ,...
%           0.8984464 , -1.0766245 , -0.238209  , -0.5233613 ,  0.8886671];
%     b2 = [-0.04129209, -0.01508532]';
% 
%     % z = w1*x + b1
%     z_lb = zeros(10, 1); z_ub = zeros(10, 1);
%     for i = 1:10
%         t_lb = 0; t_ub = 0;
%         for j = 1:2
%             if w1(i,j) >= 0
%                 t_lb = t_lb + w1(i,j) * a(j); t_ub = t_ub + w1(i,j) * b(j);
%             else
%                 t_lb = t_lb + w1(i,j) * b(j); t_ub = t_ub + w1(i,j) * a(j);
%             end
%         end
%         z_lb(i) = t_lb + b1(i); z_ub(i) = t_ub + b1(i);
%     end
% 
%     h_lb = tanh(z_lb); h_ub = tanh(z_ub);
% 
%     % dx = w2*h + b2
%     dx_lb = zeros(2, 1); dx_ub = zeros(2, 1);
%     for i = 1:2
%         t_lb = 0; t_ub = 0;
%         for j = 1:10
%             if w2(i,j) >= 0
%                 t_lb = t_lb + w2(i,j) * h_lb(j); t_ub = t_ub + w2(i,j) * h_ub(j);
%             else
%                 t_lb = t_lb + w2(i,j) * h_ub(j); t_ub = t_ub + w2(i,j) * h_lb(j);
%             end
%         end
%         dx_lb(i) = t_lb + b2(i); dx_ub(i) = t_ub + b2(i);
%     end
% end
