%         t_lb = 0; t_ub = 0;
%         for j = 1:num_neurons
%             if w2_acc(i,j) >= 0
%                 t_lb = t_lb + w2_acc(i,j) * h_lb(j); t_ub = t_ub + w2_acc(i,j) * h_ub(j);
