%------------- BEGIN OF CODE V1.7 -------------- |--> Includes the RT based Jacobian_Bounds 
% function [J_x_low,J_x_up,J_p_low,J_p_up] = UP_Jacobian_Bounds(t_init,t_final,x_low,x_up,p_low,p_up)
% 
% n_x = length(x_low);
% n_p = length(p_low);
% 
% %% Default values as NaN (not a number)
% J_x_low = NaN(n_x);
% J_x_up = NaN(n_x);
% J_p_low = NaN(n_x,n_p);
% J_p_up = NaN(n_x,n_p);
% 
% %% Globals
% global system_choice
% global Aout_global % used only for MNIST Neural ODE
% global Jacobian_x_low Jacobian_x_up
% global u % kept for compatibility
% 
% %% 0) Special case: MNIST Neural ODE (system_choice = 16)
% % dx/dt = Aout_global * x + Bout_global
% if system_choice == 16
%     if isempty(Aout_global)
%         error('UP_Jacobian_Bounds: Aout_global not set for system_choice = 16.');
%     end
% 
%     % Jacobian wrt x is Aout
%     J_x_low = Aout_global;
%     J_x_up = Aout_global;
% 
%     % Dummy input exists but does not affect dynamics => df/dp = 0
%     J_p_low = zeros(n_x, n_p);
%     J_p_up = zeros(n_x, n_p);
% 
% 
%     % % Aout_global is 676×676, and n_x = 676 for MNIST features
%     % J_x_low = Aout_global;
%     % J_x_up = Aout_global;
%     % 
%     % % ODE is autonomous in our parametrization: no real inputs → Jacobian wrt p is 0
%     % J_p_low = zeros(n_x, n_p);
%     % J_p_up = zeros(n_x, n_p);
%     return;
% end
% 
% %% 1) Try to read pre-computed Jacobians from globals (Spiral/FPA path)
% if ~isempty(Jacobian_x_low) && ~isempty(Jacobian_x_up) && ...
%     all(size(Jacobian_x_low) == [n_x, n_x]) && ...
%     all(size(Jacobian_x_up) == [n_x, n_x])
% 
%     J_x_low = Jacobian_x_low;
%     J_x_up = Jacobian_x_up;
% 
%     % autonomous → ∂f/∂p = 0
%     J_p_low = zeros(n_x, n_p);
%     J_p_up = zeros(n_x, n_p);
%     return;
% end
% % If dimensions mismatch, ignore the old globals
% Jacobian_x_low = [];
% Jacobian_x_up = [];
% 
% %% 2) System-specific hard-coded Jacobian bounds
% 
% % switch system_choice
% % case 14 % FPA (5D)
% % % You can plug in your 5×5 bounds here if you want,
% % % or keep them NaN and rely on CORA + globals for the paper examples.
% % 
% % % Example skeleton:
% % % J_x_low = [...]; % 5×5
% % % J_x_up = [...]; % 5×5
% % 
% % % No inputs as the system is autonomous
% % J_p_low = zeros(n_x, n_p);
% % J_p_up = zeros(n_x, n_p);
% % 
% % case 15 % Spiral_non (2D)
% % % Example skeleton:
% % % J_x_low = [...]; % 2×2
% % % J_x_up = [...]; % 2×2
% % 
% % % No inputs as the system is autonomous
% % J_p_low = zeros(n_x, n_p);
% % J_p_up = zeros(n_x, n_p);
% 
% switch system_choice
%     case {14, 15, 18} 
%         % FPA (14), Spiral_non (15), ACC (17), and Single Pendulum (18) 
%         % Compute bounds dynamically using the `Jacobian_bounds_element_wise.m` function
%         [J_x_low, J_x_up] = Jacob_bounds_element_wise(x_low, x_up, system_choice);
% 
%         % No inputs/disturbances affect these specific dynamics -> ∂f/∂p = 0
%         J_p_low = zeros(n_x, n_p);
%         J_p_up = zeros(n_x, n_p);
% 
%     case 17
%         % === ACC Neural ODE Plant (8D) - RT BOUNDING ===
%         delta_t = t_final - t_init;
% 
%         % 1. Compute the interval bounds of the VELOCITY at the initial set X0
%         [dx_lb_init, dx_ub_init] = compute_dynamics_interval_acc(x_low, x_up);
% 
%         % 2. Euler Bloat: Create a preliminary tube bounding box
%         %    X_tube = X0 + [0, delta_t] * F(X0)
%         tube_low_1 = x_low + min(0, dx_lb_init * delta_t);
%         tube_up_1  = x_up  + max(0, dx_ub_init * delta_t);
% 
%         % 3. Picard Refinement: Re-evaluate velocity on the bloated tube
%         %    This ensures we capture outward growth safely.
%         [dx_lb_tube, dx_ub_tube] = compute_dynamics_interval_acc(tube_low_1, tube_up_1);
% 
%         % 4. Final Reachable Tube Bounds (The physical space traversed)
%         tube_low = x_low + min(0, dx_lb_tube * delta_t);
%         tube_up  = x_up  + max(0, dx_ub_tube * delta_t);
% 
%         % 5. Evaluate the Jacobian over the full RT
%         [J_x_low, J_x_up] = Jacob_bounds_element_wise(tube_low, tube_up, system_choice);
% 
%         J_p_low = zeros(n_x, n_p);
%         J_p_up = zeros(n_x, n_p);
% 
%     otherwise
%         % Leave J_x_low, J_x_up, J_p_low, J_p_up as NaN's
%         % TIRA will complain if this system_choice is actually used.
%         warning('UP_Jacobian_Bounds: No Jacobian bounds defined for system_choice = %d.', system_choice);
% end
% 
% end
% 
% %% ========================================================================
% %  HELPER: ACC Continuous Interval Dynamics Evaluation (f(x), NOT Jacobian)
% % =========================================================================
% function [dx_lb, dx_ub] = compute_dynamics_interval_acc(a, b)
%     % Evaluates the interval bounds of the velocity (f(x)) for the ACC
%     % neural ODE example
%     global w1_acc b1_acc w2_acc b2_acc
% 
%     if isempty(w1_acc)
%         pl = load("plant_3rd_order_tanh.mat");
%         w1_acc = double(extractdata(pl.neuralOdeParameters.fc1.Weights));
%         b1_acc = double(extractdata(pl.neuralOdeParameters.fc1.Bias));
%         w2_acc = double(extractdata(pl.neuralOdeParameters.fc2.Weights));
%         b2_acc = double(extractdata(pl.neuralOdeParameters.fc2.Bias));
%         b1_acc = b1_acc(:); b2_acc = b2_acc(:);
%     end
% 
%     % Extract NN inputs (states 3, 6, 7, 8)
%     nn_idx = [3, 6, 7, 8];
%     a_sub = a(nn_idx);
%     b_sub = b(nn_idx);
% 
%     num_neurons = size(w1_acc, 1);
%     out_dim = size(w2_acc, 1);
% 
%     % 1. Bounds for z = w1 * x_sub + b1
%     z_lb = zeros(num_neurons, 1);
%     z_ub = zeros(num_neurons, 1);
%     for i = 1:num_neurons
%         t_lb = 0; t_ub = 0;
%         for j = 1:4
%             if w1_acc(i,j) >= 0
%                 t_lb = t_lb + w1_acc(i,j) * a_sub(j);
%                 t_ub = t_ub + w1_acc(i,j) * b_sub(j);
%             else
%                 t_lb = t_lb + w1_acc(i,j) * b_sub(j);
%                 t_ub = t_ub + w1_acc(i,j) * a_sub(j);
%             end
%         end
%         z_lb(i) = t_lb + b1_acc(i);
%         z_ub(i) = t_ub + b1_acc(i);
%     end
% 
%     % 2. Bounds for h = tanh(z)
%     h_lb = tanh(z_lb);
%     h_ub = tanh(z_ub);
% 
%     % 3. Bounds for nn_out = w2 * h + b2
%     nn_lb = zeros(out_dim, 1);
%     nn_ub = zeros(out_dim, 1);
%     for i = 1:out_dim
%         t_lb = 0; t_ub = 0;
%         for j = 1:num_neurons
%             if w2_acc(i,j) >= 0
%                 t_lb = t_lb + w2_acc(i,j) * h_lb(j);
%                 t_ub = t_ub + w2_acc(i,j) * h_ub(j);
%             else
%                 t_lb = t_lb + w2_acc(i,j) * h_ub(j);
%                 t_ub = t_ub + w2_acc(i,j) * h_lb(j);
%             end
%         end
%         nn_lb(i) = t_lb + b2_acc(i);
%         nn_ub(i) = t_ub + b2_acc(i);
%     end
% 
%     % 4. Assemble full 8D state derivative (velocity) bounds
%     dx_lb = zeros(8,1); dx_ub = zeros(8,1);
% 
%     dx_lb(1) = a(2); dx_ub(1) = b(2);         % dx1 = x2
%     dx_lb(2) = a(3); dx_ub(2) = b(3);         % dx2 = x3
%     dx_lb(3) = nn_lb(1); dx_ub(3) = nn_ub(1); % dx3 = NN_out_1
%     dx_lb(4) = a(5); dx_ub(4) = b(5);         % dx4 = x5
%     dx_lb(5) = a(6); dx_ub(5) = b(6);         % dx5 = x6
%     dx_lb(6) = nn_lb(2); dx_ub(6) = nn_ub(2); % dx6 = NN_out_2
%     dx_lb(7) = 0; dx_ub(7) = 0;               % Forced 0
%     dx_lb(8) = 0; dx_ub(8) = 0;               % Forced 0
% end

%------------- END OF CODE V1.7 --------------

%%


%------------- BEGIN OF CODE V1.8 -------------- |--> Includes the correct RT based Jacobian_Bounds for all examples based on a Euler-Picard-iteration-style to estimate the RT bounds using interval arithmetic
% function [J_x_low,J_x_up,J_p_low,J_p_up] = UP_Jacobian_Bounds(t_init,t_final,x_low,x_up,p_low,p_up)
% 
% n_x = length(x_low);
% n_p = length(p_low);
% 
% %% Default values as NaN (not a number)
% J_x_low = NaN(n_x);
% J_x_up = NaN(n_x);
% J_p_low = NaN(n_x,n_p);
% J_p_up = NaN(n_x,n_p);
% 
% %% Globals
% global system_choice
% global Aout_global % used only for MNIST Neural ODE
% global Jacobian_x_low Jacobian_x_up
% global u % kept for compatibility
% 
% %% 0) Special case: MNIST Neural ODE (system_choice = 16)
% % dx/dt = Aout_global * x + Bout_global
% if system_choice == 16
%     if isempty(Aout_global)
%         error('UP_Jacobian_Bounds: Aout_global not set for system_choice = 16.');
%     end
% 
%     % Jacobian wrt x is Aout
%     % Aout_global is 676×676, and n_x = 676 for MNIST features
%     J_x_low = Aout_global;
%     J_x_up = Aout_global;
% 
%     % ODE is autonomous in our parametrization "i.e., no real inputs" => Jacobian wrt p is 0 (df/dp = 0)
%     J_p_low = zeros(n_x, n_p);
%     J_p_up = zeros(n_x, n_p);
% 
%     return;
% end
% 
% %% 1) Try to read pre-computed Jacobians from globals (Spiral/FPA path)
% if ~isempty(Jacobian_x_low) && ~isempty(Jacobian_x_up) && ...
%     all(size(Jacobian_x_low) == [n_x, n_x]) && ...
%     all(size(Jacobian_x_up) == [n_x, n_x])
% 
%     J_x_low = Jacobian_x_low;
%     J_x_up = Jacobian_x_up;
% 
%     % autonomous → ∂f/∂p = 0
%     J_p_low = zeros(n_x, n_p);
%     J_p_up = zeros(n_x, n_p);
%     return;
% end
% % If dimensions mismatch, ignore the old globals
% Jacobian_x_low = [];
% Jacobian_x_up = [];
% 
% %% 2) System-specific via Reachable Tube (RT) OA estimation
% 
% delta_t = t_final - t_init;
% 
% switch system_choice
%     case {14, 15, 17, 18} 
%         % FPA (14), Spiral_non (15), ACC (17), Single Pendulum (18)
% 
%         % 1. Compute the interval bounds of dx/dt (time derivative of the state vector) at the initial set X0 (the box that the initial state is currently bounded in at t_{init})    
%         [dx_lb_init, dx_ub_init] = compute_system_dynamics_interval(x_low, x_up, system_choice);
% 
%         % 2. Euler Bloat: Create a preliminary tube bounding box
%         %    X_tube = X0 + [0, delta_t] * f(X0)
%         tube_low_1 = x_low + min(0, dx_lb_init * delta_t);
%         tube_up_1  = x_up  + max(0, dx_ub_init * delta_t);
% 
%         % 3. Picard Refinement: Re-evaluate velocity on the bloated tube
%         [dx_lb_tube, dx_ub_tube] = compute_dynamics_interval_acc(tube_low_1, tube_up_1);
% 
%         % 4. Final Reachable Tube Bounds (The physical space traversed)
%         tube_low = x_low + min(0, dx_lb_tube * delta_t);
%         tube_up  = x_up  + max(0, dx_ub_tube * delta_t);
% 
%         % 5. Evaluate the Jacobian over the full Reachable Tube
%         [J_x_low, J_x_up] = Jacob_bounds_element_wise(tube_low, tube_up, system_choice);
% 
%         % Autonomous systems -> df/dp = 0
%         J_p_low = zeros(n_x, n_p);
%         J_p_up = zeros(n_x, n_p);
% 
%     otherwise
%         % Leave J_x_low, J_x_up, J_p_low, J_p_up as NaN's
%         % TIRA will complain if this system_choice is actually used.
%         warning('UP_Jacobian_Bounds: No Jacobian bounds defined for system_choice = %d.', system_choice);
% end
% 
% end
% 
% %% ========================================================================
% %                           Helper Functions
% % =========================================================================
% 
% % % 1. Route Continuous Interval Dynamics Evaluation (f(x))
% function [dx_lb, dx_ub] = compute_system_dynamics_interval(a, b, system_choice)
%     switch system_choice
%         case 14
%             [dx_lb, dx_ub] = compute_dynamics_interval_fpa(a, b);
%         case 15
%             [dx_lb, dx_ub] = compute_dynamics_interval_spiral(a, b);
%         case 17
%             [dx_lb, dx_ub] = compute_dynamics_interval_acc(a, b);
%         case 18
%             [dx_lb, dx_ub] = compute_dynamics_interval_pendulum(a, b);
%     end
% end
% 
% % % 2. FPA Interval Dynamics
% function [dx_lb, dx_ub] = compute_dynamics_interval_fpa(a, b)
%     tau = -1e-6;
%     A = [-1.20327, -0.07202, -0.93635; 1.18810, -1.50015,  0.93519];
%     B = [ 1.21464, -0.10502; 0.12023,  0.19387; -1.36695,  0.12201];
%     BA = B * A;
%     W = [zeros(2,2), A; zeros(3,2), BA];
% 
%     tanh_lb = tanh(a);
%     tanh_ub = tanh(b);
% 
%     dx_lb = zeros(5,1); dx_ub = zeros(5,1);
%     for i = 1:5
%         t_lb = 0; t_ub = 0;
%         for j = 1:5
%             if W(i,j) >= 0
%                 t_lb = t_lb + W(i,j) * tanh_lb(j);
%                 t_ub = t_ub + W(i,j) * tanh_ub(j);
%             else
%                 t_lb = t_lb + W(i,j) * tanh_ub(j);
%                 t_ub = t_ub + W(i,j) * tanh_lb(j);
%             end
%         end
%         % dx = tau*x + W*tanh(x)
%         % Note: tau is negative (-1e-6), so tau*b is the lower bound contribution
%         dx_lb(i) = t_lb + tau * b(i);
%         dx_ub(i) = t_ub + tau * a(i); 
%     end
% end
% 
